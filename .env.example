# Database
KIVI_DATABASE_URL=postgresql://kivi:kivi_dev@localhost:5432/kivi_memory

# Redis
REDIS_URL=redis://localhost:6379/0
KIVI_THREAD_TTL_SECONDS=604800
KIVI_THREAD_MAX_MESSAGES=500
KIVI_THREAD_CONTEXT_MESSAGES=24
KIVI_THREAD_CONTEXT_MAX_CHARS=12000
KIVI_THREAD_CONTEXT_EPISODES=6
KIVI_THREAD_CONTEXT_MAX_TOKENS=2500
KIVI_THREAD_ACTIVE_WINDOW_EPISODES=20
KIVI_THREAD_ACTIVE_WINDOW_TOKENS=8000
KIVI_WRITEBACK_BATCH_SIZE=3
KIVI_WRITEBACK_IDLE_FLUSH_SECONDS=180
KIVI_WRITEBACK_ON_TURN_ENABLED=false
KIVI_WRITEBACK_LOCK_SECONDS=300

# Ollama / Local Models
OLLAMA_BASE_URL=http://localhost:11434
KIVI_MODEL=qwen3.5:9b
KIVI_SEMANTIC_COMPILER_MODEL=qwen3.5:9b
KIVI_SEMANTIC_COMPILER_THINK=true
KIVI_TEMPORAL_MODEL=qwen3.5:9b
KIVI_TEMPORAL_REASONING_MODEL=qwen3.5:9b
KIVI_TEMPORAL_NORMALIZATION_MODEL=qwen3.5:9b
KIVI_TEMPERATURE=0
KIVI_MAX_ATTEMPTS=2
KIVI_OLLAMA_TIMEOUT_SECONDS=120

# Retrieval
KIVI_VECTOR_SEARCH_MODE=hnsw
KIVI_HNSW_EF_SEARCH=100
KIVI_GRAPH_TOP_K=8
KIVI_GRAPH_MAX_BRIDGE_DEGREE=50
KIVI_GRAPH_RERANK_WEIGHT=0.15
KIVI_READ_RETRIEVAL_TOP_K=12
KIVI_READ_RETRIEVAL_BRANCH_K=24

# Read Router / Orchestrator
KIVI_ROUTER_MODEL=qwen3.5:4b
KIVI_ROUTER_TEMPERATURE=0
KIVI_ROUTER_MAX_RETRIEVAL_QUERIES=3
KIVI_ORCHESTRATOR_MEMORY_LIMIT=16
KIVI_AGENT_MAX_MEMORIES=12

# Sarvam Final Answer Model
SARVAM_API_KEY=
KIVI_HEY_KIVI_PROVIDER=sarvam
KIVI_HEY_KIVI_MODEL=sarvam-105b
KIVI_HEY_KIVI_REASONING_EFFORT=low
KIVI_HEY_KIVI_TEMPERATURE=0.2
KIVI_HEY_KIVI_MAX_TOKENS=4096
KIVI_HEY_KIVI_TIMEOUT_SECONDS=120

# Web Search
KIVI_WEB_PROVIDER=tavily
TAVILY_API_KEY=

# Frontend
VITE_KIVI_API_BASE_URL=http://127.0.0.1:8000
